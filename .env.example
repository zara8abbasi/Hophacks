# ElevenLabs Scribe STT + TTS for /speech (Creator plan is enough)
# Without this key, /speech uses browser speech recognition and speechSynthesis.
ELEVENLABS_API_KEY=
# Optional ElevenLabs voice for the one-sentence recycle readout (server-only)
# ELEVENLABS_VOICE_ID=

# xAI Grok — used only on the server for Type A Description, speech, and picture classification
XAI_API_KEY=
# Alternative name (either works)
# GROK_API_KEY=
# Optional model override (default: grok-3-mini for text, grok-4.6 for photos)
# GROK_MODEL=grok-3-mini
# GROK_VISION_MODEL=grok-4.6
